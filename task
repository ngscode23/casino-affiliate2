2) Функция: выдать подписанный URL для загрузки
Создай netlify/functions/admin-get-upload-url.ts:
import type { Handler } from '@netlify/functions'
import { createClient } from '@supabase/supabase-js'
import { requireAdmin } from './_lib/auth' // твой guard из прошлого шага

const URL = process.env.SUPABASE_URL!
const SERVICE = process.env.SUPABASE_SERVICE_ROLE_KEY!
const BUCKET = process.env.SUPABASE_PRODUCT_BUCKET || 'product-images'

export const handler: Handler = async (event) => {
  // только админ
  const auth = await requireAdmin(event)
  if (!auth.ok) return { statusCode: auth.status, body: auth.body }

  if (event.httpMethod !== 'POST') {
    return { statusCode: 405, body: 'Method Not Allowed' }
  }

  try {
    const { productId, sku, ext = 'webp' } = JSON.parse(event.body || '{}')
    if (!productId || !sku) return { statusCode: 400, body: 'productId and sku required' }

    const path = `${sku}/main.${ext}`

    const supa = createClient(URL, SERVICE, { auth: { persistSession: false } })

    // 1) подписанный одноразовый URL на загрузку
    // v2 API: createSignedUploadUrl
    const { data, error } = await (supa as any)
      .storage.from(BUCKET)
      .createSignedUploadUrl(path)  // {path, token, url}
    if (error) throw error

    // 2) сразу проставим image_path в товар (если пусто или хотим перезапись)
    const { error: upErr } = await supa
      .from('shop.products')
      .update({ image_path: path })
      .eq('id', productId)
    if (upErr) throw upErr

    return {
      statusCode: 200,
      body: JSON.stringify({
        uploadUrl: data?.signedUrl || data?.url,
        token: data?.token,  // если понадобится ручной POST
        path,
        publicUrl: `${URL}/storage/v1/object/public/${BUCKET}/${path}`
      })
    }
  } catch (e: any) {
    return { statusCode: 500, body: e.message || 'upload url error' }
  }
}


Примечание: если у твоей версии @supabase/supabase-js метод называется иначе или возвращает { signedUrl, token }, оставь как в доке твоей версии. Суть та же.

3) Фронт админки: запросить URL и загрузить файл
В редакторе товара на кнопке «Загрузить»:
async function uploadProductImage(productId: string, sku: string, file: File) {
  // 1) получить одноразовый URL
  const token = (await supabase.auth.getSession()).data.session?.access_token
  const res = await fetch('/.netlify/functions/admin-get-upload-url', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      Authorization: `Bearer ${token}`
    },
    body: JSON.stringify({ productId, sku, ext: file.name.split('.').pop() || 'webp' })
  })
  if (!res.ok) throw new Error(await res.text())
  const { uploadUrl, publicUrl } = await res.json()

  // 2) прямая загрузка в Storage (без перегонки через твой сервер)
  const put = await fetch(uploadUrl, {
    method: 'PUT',
    headers: { 'Content-Type': file.type || 'application/octet-stream' },
    body: file
  })
  if (!put.ok) throw new Error(`Upload failed: ${put.status}`)

  return publicUrl // можно сразу показать превью
}

После загрузки просто перезагрузи данные товара, витрина подхватит image_path. Если фронт берёт товары через API, а не из статичного массива, картинки появятся без правок кода.
