{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "baseUrl": ".",
    "types": [
      "react",
      "react-dom",
      "next",
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ui/*": [
        "../../packages/ui/src/*"
      ],
      "@shared/*": [
        "../../packages/shared/src/*"
      ],
      "@casino-affiliate/types": [
        "../../packages/types/src/index"
      ],
      "@casino-affiliate/types/*": [
        "../../packages/types/src/types/*"
      ],
      "@types": [
        "../../packages/types/src/index"
      ],
      "@types/*": [
        "../../packages/types/src/types/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
