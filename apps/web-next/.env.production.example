# Get these from your API settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Get this from your Vercel project settings
NEXT_SITE_URL=https://<your-vercel-project-name>.<your-vercel-org-name>.vercel.app/
NEXT_REDIRECT_URLS=https://<your-vercel-project-name>.<your-vercel-org-name>.vercel.app/,https://<your-vercel-project-name>.<your-vercel-org-name>.vercel.app/**
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_ADMIN_TOKEN=ddb27690d96f4d788d0197ec209fa469
ADMIN_TOKEN=ddb27690d96f4d788d0197ec209fa469



NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXTAUTH_URL=https://your-site.vercel.app
AUTH_TRUST_HOST=true
NODE_ENV=production

# Stripe payments (server-side only)
# Secret API key, e.g. sk_live_*** or sk_test_***
STRIPE_SECRET_KEY=your-stripe-secret-key
# Webhook signing secret used by /api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_********************************

# Tracking diagnostics (enable only in dev)
TRACK_DEBUG=0

# Optional: payment notifications (emails)
# Provider can be 'postmark' or 'resend'. Leave empty to disable.
PAYMENTS_NOTIFY_PROVIDER=
PAYMENTS_NOTIFY_FROM=no-reply@example.com
PAYMENTS_NOTIFY_TO=admin@example.com
PAYMENTS_NOTIFY_BCC=
PAYMENTS_NOTIFY_SEND_TO_USER=0

# If PAYMENTS_NOTIFY_PROVIDER=postmark or resend, set a token below
POSTMARK_TOKEN=
RESEND_API_KEY=

# Contact form notifications
CONTACT_NOTIFY_PROVIDER=
CONTACT_NOTIFY_FROM=hello@example.com
CONTACT_NOTIFY_TO=team@example.com
