# зафиксируй тут руками вернувшийся UUID партнёра, подставь в следующую команду:
$partner = '6ee9c717-5363-4b97-95ba-46f22e001da4'

# связка + пин
docker compose exec -T postgres psql -U app -d appdb -c `
"with o as (select id as offer_id from public.offers where slug='test')
 insert into public.partner_offers (partner_id, offer_id, pinned)
 select '$partner'::uuid, o.offer_id, true from o
 on conflict (partner_id, offer_id) do update set pinned = excluded.pinned;"

 # связка и пин
docker compose exec -T postgres psql -U app -d appdb -c "
SELECT o.slug, po.pinned
FROM public.partner_offers po
JOIN public.offers o ON o.id = po.offer_id
ORDER BY po.created_at DESC
LIMIT 5;"


