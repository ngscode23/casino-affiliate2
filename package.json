{
  "name": "casino-affiliate-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "dev:web-next": "turbo run dev --filter=web-next",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:functions": "turbo run dev --filter=functions",
