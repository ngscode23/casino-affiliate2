{
  "name": "casino-affiliate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",

  
  "scripts": {
    "preinstall": "node -e \"const ua=(process.env.npm_config_user_agent||''); if(!ua.startsWith('pnpm/')){console.error('Use pnpm (packageManager=pnpm@9.0.0). Install: corepack enable && corepack prepare pnpm@9.0.0 --activate'); process.exit(1)}\"",
   
    "dev": "vite",
    "dev:functions": "netlify dev -p 8888",
    "preview": "vite preview --port 5174",
    "clean": "rimraf node_modules package-lock.json .turbo .vite .cache dist",
    "prepare": "husky",
    "test": "vitest run --passWithNoTests --reporter verbose --config vitest.config.ts",
    "test:watch": "vitest --reporter verbose --watch",
    "test:coverage": "vitest run --coverage --reporter verbose",
    "test:coverage:watch": "vitest --coverage --reporter verbose --watch",
    "build": "node -e \"process.env.SITE_ORIGIN=process.env.SITE_ORIGIN||'https://lucky-macaron-c3c96c.netlify.app/'\" && node scripts/generate-sitemap.mjs && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "fn:test:impression": "curl.exe -i -X POST http://localhost:8888/.netlify/functions/track-impression -H \"Content-Type: application/json\" -d '{\"slug\":\"lucky-star\"}'",
    "fn:test:impression:prod": "curl.exe -i -X POST https://lucky-macaron-c3c96c.netlify.app/.netlify/functions/track-impression -H \"Content-Type: application/json\" -d '{\"slug\":\"lucky-star\"}'"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@sentry/react": "^10.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.540.0",
    "node-fetch": "^3.3.2",
    "openai": "^5.16.0",
    "posthog-js": "^1.261.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.1",
    "sonner": "^2.0.7",
    "stripe": "^12.18.0",
    "tailwind-merge": "^3.3.1",
    "zod": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@netlify/functions": "^4.2.2",
    "@playwright/test": "^1.55.0",
    "@sentry/vite-plugin": "^4.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lightningcss": "^1.30.1",
    "netlify-cli": "^23.5.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
