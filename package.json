{
  "name": "casino-affiliate-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:web-next": "turbo run dev --filter=web-next",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:functions": "turbo run dev --filter=functions",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prepare": "husky",
    "dev:admin:netlify": "netlify dev --cwd apps/admin --port 8888 --target-port 5174",
    "dev:admin:clean": "powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; Get-Process netlify -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 150; netlify dev --cwd apps/admin --port 8888 --target-port 5174\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@supabase/mcp-server-supabase": "^0.5.5",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.9",
      "@esbuild/*": "0.25.9"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@tailwindcss/oxide",
      "core-js",
      "esbuild",
      "netlify-cli",
      "sharp",
      "unix-dgram"
    ]
  },
  "packageManager": "pnpm@9.11.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
