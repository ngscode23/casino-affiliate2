    "clean": "turbo run clean",
    "prepare": "husky",
    "dev:admin:netlify": "netlify dev --cwd apps/admin --port 8888 --target-port 5174",
    "dev:admin:clean": "powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; Get-Process netlify -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 150; netlify dev --cwd apps/admin --port 8888 --target-port 5174\""
  },
