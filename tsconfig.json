{
 "extends": "./tsconfig.base.json",
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "coverage",
    "playwright-report",
    "test-results",
    "_archive"
  ],
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/web-next/*",
        "apps/cms-admin/*"
      ],
      "@shared/*": [
        "packages/shared/src/*"
      ],
      "@ui/*": [
        "packages/ui/src/*"
      ],
      "@types/*": [
        "packages/types/src/types/*"
      ],
      "@types": [
        "packages/types/src/index"
      ],
      "@casino-affiliate/types": [
        "packages/types/src/index"
      ],
      "@casino-affiliate/types/*": [
        "packages/types/src/types/*"
      ],
      "@web-next/*": [
        "apps/web-next/*"
      ],
      "lucide-react": [
        "node_modules/lucide-react/dist/lucide-react"
      ]
    },
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,
    "types": [
      "next",
      "react",
      "react-dom",
      "node",
      "vitest"
    ]
  }
}
