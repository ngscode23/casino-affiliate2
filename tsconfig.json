{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/web-next/*"
      ],
      "@shared/*": [
        "packages/shared/src/*"
      ],
      "@ui/*": [
        "packages/ui/src/*"
      ],
      "@types/*": [
        "packages/types/src/types/*"
      ],
      "@types": [
        "packages/types/src/index"
      ],
      "@casino-affiliate/types": [
        "packages/types/src/index"
      ],
      "@casino-affiliate/types/*": [
        "packages/types/src/types/*"
      ],
      "@web-next/*": [
        "apps/web-next/*"
      ]
    },
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,
    "types": [
      "next",
      "react",
      "react-dom",
      "node",
      "vitest"
    ]
  }
}
