# Local-only env for docker-compose (optional)
# docker compose --env-file .env.docker up -d

POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=app
PG_PORT=5432

# pgAdmin credentials
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
DB_DSN=postgresql://app:apppass@localhost:5432/appdb
DB_DSN=postgresql://app:apppass@localhost:6543/appdb

